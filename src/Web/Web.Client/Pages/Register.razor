@page "/register"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthApiClient AuthApi
@inject IAuthSession AuthSession
@inject NavigationManager Navigation

<PageTitle>Register · TraderAnalyzer</PageTitle>

<div class="auth-card">
    <header class="auth-header">
        <p class="auth-eyebrow">Get started</p>
        <h1>Create account</h1>
        <p class="auth-subtitle">Join TraderAnalyzer to track pairs and pattern signals.</p>
    </header>

    <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync" OnInvalidSubmit="HandleInvalid">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label for="firstName">First name</label>
            <InputText id="firstName" class="auth-input" @bind-Value="_model.FirstName" autocomplete="given-name" />
            <ValidationMessage For="() => _model.FirstName" />
        </div>

        <div class="auth-field">
            <label for="lastName">Last name</label>
            <InputText id="lastName" class="auth-input" @bind-Value="_model.LastName" autocomplete="family-name" />
            <ValidationMessage For="() => _model.LastName" />
        </div>

        <div class="auth-field">
            <label for="username">Username</label>
            <InputText id="username" class="auth-input" @bind-Value="_model.Username" autocomplete="username" placeholder="choose a username" />
            <ValidationMessage For="() => _model.Username" />
        </div>

        <div class="auth-field">
            <label for="email">Email</label>
            <InputText id="email" class="auth-input" @bind-Value="_model.Email" autocomplete="email" placeholder="you@example.com" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        <div class="auth-field">
            <label for="currency">Preferred currency</label>
            <InputSelect id="currency" class="auth-input" @bind-Value="_model.PreferredCurrency">
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="GBP">GBP</option>
                <option value="IRR">IRR</option>
            </InputSelect>
            <ValidationMessage For="() => _model.PreferredCurrency" />
        </div>

        <div class="auth-field">
            <label for="password">Password</label>
            <div class="auth-password-wrap">
                <input id="password"
                       type="@(_showPassword ? "text" : "password")"
                       class="auth-input"
                       value="@_model.Password"
                       @oninput="OnPasswordInput"
                       autocomplete="new-password"
                       placeholder="••••••••" />
                <button type="button" class="auth-reveal" @onclick="TogglePassword">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
            <ValidationMessage For="() => _model.Password" />
            <PasswordQualityMeter Password="_model.Password" OnValidityChanged="OnPasswordQualityChanged" />
        </div>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <p class="auth-error" role="alert">@_formError</p>
        }

        <button type="submit" class="auth-submit" disabled="@_isSubmitting">
            @(_isSubmitting ? "Creating…" : "Create account")
        </button>
    </EditForm>

    <p class="auth-footer">
        Already have an account?
        <a href="login">Sign in</a>
    </p>
</div>

@code {
    private readonly RegisterModel _model = new();
    private bool _showPassword;
    private bool _isSubmitting;
    private bool _passwordStrong;
    private string? _formError;

    private void TogglePassword() => _showPassword = !_showPassword;
    private void OnPasswordQualityChanged(bool isStrong) => _passwordStrong = isStrong;
    private void HandleInvalid() => _formError = "Please fix the highlighted fields.";

    private void OnPasswordInput(ChangeEventArgs e)
    {
        _model.Password = e.Value?.ToString() ?? string.Empty;
        _passwordStrong = PasswordQualityMeter.MeetsRequirements(_model.Password);
    }

    private async Task HandleRegisterAsync()
    {
        _formError = null;
        _passwordStrong = PasswordQualityMeter.MeetsRequirements(_model.Password);
        if (!_passwordStrong)
        {
            _formError = "Password does not meet quality requirements.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var response = await AuthApi.RegisterAsync(new RegisterRequest(
                _model.Email.Trim(),
                _model.Username.Trim(),
                _model.Password,
                _model.FirstName.Trim(),
                _model.LastName.Trim(),
                _model.PreferredCurrency));

            await AuthSession.SetSessionAsync(response);
            Navigation.NavigateTo("/");
        }
        catch (AuthApiException ex)
        {
            _formError = FormatApiError(ex);
        }
        catch (HttpRequestException)
        {
            _formError = "Cannot reach the account API. Is API.Account running on port 5065?";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string FormatApiError(AuthApiException ex)
    {
        if (ex.Errors is { Count: > 0 })
        {
            var first = ex.Errors.SelectMany(pair => pair.Value).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(first))
                return first;
        }

        return ex.Message;
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "First name is required.")]
        [MaxLength(100)]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required.")]
        [MaxLength(100)]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Username is required.")]
        [MinLength(3)]
        [MaxLength(64)]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        [MaxLength(256)]
        public string Email { get; set; } = string.Empty;

        [Required]
        [StringLength(3, MinimumLength = 3)]
        public string PreferredCurrency { get; set; } = "USD";

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8)]
        [MaxLength(128)]
        public string Password { get; set; } = string.Empty;
    }
}
