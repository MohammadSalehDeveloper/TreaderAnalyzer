@page "/reset-password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthApiClient AuthApi
@inject NavigationManager Navigation

<PageTitle>Reset password · TraderAnalyzer</PageTitle>

<div class="auth-card">
    <header class="auth-header">
        <p class="auth-eyebrow">Account recovery</p>
        <h1>Reset password</h1>
        <p class="auth-subtitle">Choose a new strong password for your account.</p>
    </header>

    @if (string.IsNullOrWhiteSpace(_token))
    {
        <p class="auth-error" role="alert">Reset token is missing. Open the link from your email.</p>
        <p class="auth-footer"><a href="forgot-password">Request a new link</a></p>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" OnInvalidSubmit="HandleInvalid">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label for="password">New password</label>
                <div class="auth-password-wrap">
                    <input id="password"
                           type="@(_showPassword ? "text" : "password")"
                           class="auth-input"
                           value="@_model.Password"
                           @oninput="OnPasswordInput"
                           autocomplete="new-password"
                           placeholder="••••••••" />
                    <button type="button" class="auth-reveal" @onclick="() => _showPassword = !_showPassword">
                        @(_showPassword ? "Hide" : "Show")
                    </button>
                </div>
                <ValidationMessage For="() => _model.Password" />
                <PasswordQualityMeter Password="_model.Password" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="auth-error" role="alert">@_error</p>
            }

            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="auth-success" role="status">@_message</p>
            }

            <button type="submit" class="auth-submit" disabled="@_isSubmitting">
                @(_isSubmitting ? "Saving…" : "Update password")
            </button>
        </EditForm>

        <p class="auth-footer">
            <a href="login">Back to sign in</a>
        </p>
    }
</div>

@code {
    private readonly ResetModel _model = new();
    private string? _token;
    private bool _showPassword;
    private bool _isSubmitting;
    private string? _error;
    private string? _message;

    protected override void OnInitialized()
    {
        _token = GetQueryParam(Navigation.ToAbsoluteUri(Navigation.Uri), "token");
    }

    private static string? GetQueryParam(Uri uri, string name)
    {
        if (string.IsNullOrEmpty(uri.Query))
            return null;

        foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2)
                continue;

            if (!string.Equals(Uri.UnescapeDataString(pair[0]), name, StringComparison.OrdinalIgnoreCase))
                continue;

            return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
        }

        return null;
    }

    private void HandleInvalid() => _error = "Please fix the highlighted fields.";

    private void OnPasswordInput(ChangeEventArgs e) =>
        _model.Password = e.Value?.ToString() ?? string.Empty;

    private async Task HandleSubmitAsync()
    {
        _error = null;
        _message = null;

        if (!PasswordQualityMeter.MeetsRequirements(_model.Password))
        {
            _error = "Password does not meet quality requirements.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = "Reset token is missing.";
            return;
        }

        _isSubmitting = true;
        try
        {
            await AuthApi.ResetPasswordAsync(new ResetPasswordRequest(_token, _model.Password));
            _message = "Password updated. You can sign in with your new password.";
        }
        catch (AuthApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the account API. Is API.Account running on port 5065?";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8)]
        [MaxLength(128)]
        public string Password { get; set; } = string.Empty;
    }
}
