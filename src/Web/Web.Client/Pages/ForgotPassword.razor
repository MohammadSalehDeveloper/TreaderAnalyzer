@page "/forgot-password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthApiClient AuthApi

<PageTitle>Forgot password · TraderAnalyzer</PageTitle>

<div class="auth-card">
    <header class="auth-header">
        <p class="auth-eyebrow">Account recovery</p>
        <h1>Forgot password</h1>
        <p class="auth-subtitle">Enter your email and we’ll send a reset link if an account exists.</p>
    </header>

    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label for="email">Email</label>
            <InputText id="email" class="auth-input" @bind-Value="_model.Email" autocomplete="email" placeholder="you@example.com" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="auth-error" role="alert">@_error</p>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="auth-success" role="status">@_message</p>
        }

        <button type="submit" class="auth-submit" disabled="@_isSubmitting">
            @(_isSubmitting ? "Sending…" : "Send reset link")
        </button>
    </EditForm>

    <p class="auth-footer">
        Remembered it?
        <a href="login">Back to sign in</a>
    </p>
</div>

@code {
    private readonly ForgotModel _model = new();
    private bool _isSubmitting;
    private string? _message;
    private string? _error;

    private async Task HandleSubmitAsync()
    {
        _message = null;
        _error = null;
        _isSubmitting = true;
        try
        {
            await AuthApi.ForgotPasswordAsync(new ForgotPasswordRequest(_model.Email.Trim()));
            _message = "If that email is registered, a reset link will be sent. Check API logs in development.";
        }
        catch (AuthApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the account API. Is API.Account running on port 5065?";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ForgotModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
