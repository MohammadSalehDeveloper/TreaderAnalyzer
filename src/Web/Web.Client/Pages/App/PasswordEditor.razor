@using System.ComponentModel.DataAnnotations
@inject IAccountApiClient AccountApi

<section class="panel-page">
    <p class="panel-kicker">Trader</p>
    <h1>Password</h1>
    <p class="panel-lead">Choose a new password for this account.</p>

    <EditForm class="panel-form" Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalid">
        <DataAnnotationsValidator />

        <div class="panel-field">
            <label for="current-password">Current password</label>
            <input id="current-password"
                   type="password"
                   class="panel-input"
                   autocomplete="current-password"
                   @bind="_model.CurrentPassword"
                   @bind:event="oninput" />
            <ValidationMessage For="() => _model.CurrentPassword" />
        </div>

        <div class="panel-field">
            <label for="new-password">New password</label>
            <input id="new-password"
                   type="password"
                   class="panel-input"
                   autocomplete="new-password"
                   @bind="_model.NewPassword"
                   @bind:event="oninput" />
            <PasswordQualityMeter Password="_model.NewPassword" />
            <ValidationMessage For="() => _model.NewPassword" />
        </div>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <p class="panel-error" role="alert">@_formError</p>
        }

        <div class="panel-actions">
            <button type="submit" class="panel-button" disabled="@_saving">
                @(_saving ? "Saving…" : "Change password")
            </button>
            @if (!string.IsNullOrEmpty(_saved))
            {
                <p class="panel-ok" role="status">@_saved</p>
            }
        </div>
    </EditForm>
</section>

@code {
    private readonly PasswordModel _model = new();
    private bool _saving;
    private string? _formError;
    private string? _saved;

    private void HandleInvalid() => _formError = "Please fix the highlighted fields.";

    private async Task SaveAsync()
    {
        _formError = null;
        _saved = null;

        if (!PasswordQualityMeter.MeetsRequirements(_model.NewPassword))
        {
            _formError = "Password does not meet quality requirements.";
            return;
        }

        _saving = true;
        try
        {
            await AccountApi.ChangePasswordAsync(
                new ChangePasswordRequest(_model.CurrentPassword, _model.NewPassword));
            _model.CurrentPassword = string.Empty;
            _model.NewPassword = string.Empty;
            _saved = "Password changed.";
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _formError = "Cannot reach the account API. Is API.Account running on port 5065?";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "Current password is required.")]
        [MaxLength(128)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        [MaxLength(128)]
        public string NewPassword { get; set; } = string.Empty;
    }
}
