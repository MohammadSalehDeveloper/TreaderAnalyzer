<div class="pw-quality" aria-live="polite">
    <div class="pw-meter" role="meter" aria-valuemin="0" aria-valuemax="4" aria-valuenow="@Score" aria-label="Password strength">
        <span class="pw-meter-fill @StrengthClass" style="width:@($"{Score * 25}%")"></span>
    </div>
    <p class="pw-label">
        Strength: <strong>@StrengthLabel</strong>
    </p>
    <ul class="pw-rules">
        <li class="@(_hasMinLength ? "is-met" : null)"><span>@Icon(_hasMinLength)</span> At least 8 characters</li>
        <li class="@(_hasUpper ? "is-met" : null)"><span>@Icon(_hasUpper)</span> One uppercase letter</li>
        <li class="@(_hasLower ? "is-met" : null)"><span>@Icon(_hasLower)</span> One lowercase letter</li>
        <li class="@(_hasDigit ? "is-met" : null)"><span>@Icon(_hasDigit)</span> One number</li>
        <li class="@(_hasSymbol ? "is-met" : null)"><span>@Icon(_hasSymbol)</span> One symbol (!@@#$…)</li>
    </ul>
</div>

@code {
    private bool _hasMinLength;
    private bool _hasUpper;
    private bool _hasLower;
    private bool _hasDigit;
    private bool _hasSymbol;
    private int _ruleCount;

    [Parameter] public string? Password { get; set; }
    [Parameter] public EventCallback<bool> OnValidityChanged { get; set; }

    public int Score => _ruleCount switch
    {
        >= 5 => 4,
        4 => 3,
        3 => 2,
        >= 1 => 1,
        _ => 0
    };

    public bool IsStrongEnough => _ruleCount >= 5;

    public static bool MeetsRequirements(string? password)
    {
        if (string.IsNullOrEmpty(password) || password.Length < 8)
            return false;

        EvaluateRules(password, out _, out var hasUpper, out var hasLower, out var hasDigit, out var hasSymbol);
        return hasUpper && hasLower && hasDigit && hasSymbol;
    }

    private string StrengthClass => Score switch
    {
        1 => "weak",
        2 => "fair",
        3 => "good",
        4 => "strong",
        _ => "empty"
    };

    private string StrengthLabel => Score switch
    {
        1 => "Weak",
        2 => "Fair",
        3 => "Good",
        4 => "Strong",
        _ => "Enter a password"
    };

    protected override async Task OnParametersSetAsync()
    {
        var password = Password ?? string.Empty;
        var previous = IsStrongEnough;
        Apply(password);

        if (previous == IsStrongEnough || !OnValidityChanged.HasDelegate)
            return;

        await OnValidityChanged.InvokeAsync(IsStrongEnough);
    }

    private void Apply(string password)
    {
        EvaluateRules(password, out _hasMinLength, out _hasUpper, out _hasLower, out _hasDigit, out _hasSymbol);
        _ruleCount = (_hasMinLength ? 1 : 0)
            + (_hasUpper ? 1 : 0)
            + (_hasLower ? 1 : 0)
            + (_hasDigit ? 1 : 0)
            + (_hasSymbol ? 1 : 0);
    }

    private static void EvaluateRules(
        string password,
        out bool hasMinLength,
        out bool hasUpper,
        out bool hasLower,
        out bool hasDigit,
        out bool hasSymbol)
    {
        hasMinLength = password.Length >= 8;
        hasUpper = false;
        hasLower = false;
        hasDigit = false;
        hasSymbol = false;

        foreach (var ch in password)
        {
            if (char.IsUpper(ch))
                hasUpper = true;
            else if (char.IsLower(ch))
                hasLower = true;
            else if (IsNumberChar(ch))
                hasDigit = true;
            else if (!char.IsLetter(ch))
                hasSymbol = true;
        }
    }

    /// <summary>ASCII 0-9 and other Unicode decimal digits (e.g. Persian ۰-۹).</summary>
    private static bool IsNumberChar(char ch) =>
        ch is >= '0' and <= '9' || char.IsDigit(ch);

    private static string Icon(bool met) => met ? "✓" : "○";
}
